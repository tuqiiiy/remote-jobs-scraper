{
  "title": "Remote Jobs Scraper Input Schema",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "tag": {
      "title": "Role / Skill Tag",
      "type": "string",
      "description": "Filter by job category or skill.",
      "editor": "select",
      "default": "all",
      "enum": [
        "all",
        "dev",
        "ai",
        "engineer",
        "marketing",
        "sales",
        "design",
        "management",
        "finance",
        "crypto"
      ],
      "enumTitles": [
        "All Remote Jobs",
        "Software Development (Dev)",
        "Artificial Intelligence (AI)",
        "Engineering",
        "Marketing & Growth",
        "Sales & Business Development",
        "Design & UX",
        "Management & Product",
        "Finance & Ops",
        "Crypto & Web3"
      ]
    },
    "maxJobs": {
      "title": "Max Jobs to Extract",
      "type": "integer",
      "description": "Maximum number of remote job listings to retrieve.",
      "minimum": 1,
      "maximum": 500,
      "default": 50
    },
    "requireSalaryOnly": {
      "title": "Require Declared Salary",
      "type": "boolean",
      "description": "If enabled, only jobs with transparent minimum/maximum salary numbers will be included.",
      "default": false
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Optional proxy configuration.",
      "editor": "proxy"
    }
  },
  "required": []
}
